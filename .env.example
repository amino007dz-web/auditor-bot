# =============================================================================
# Smart Contract Auditor — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your keys.
# NEVER commit the .env file to version control.
# =============================================================================

# --- LLM Provider ---
# Supported: ollama, openrouter, groq
API_PROVIDER=ollama

# Ollama Cloud
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=your_ollama_api_key_here
OLLAMA_MODEL=qwen3-coder:480b
OLLAMA_TIMEOUT=300

# OpenRouter (deprecated fallback)
# OPENROUTER_API_KEY=sk-or-v1-your_key_here
# OPENROUTER_API_KEYS=key1,key2,key3,...

# --- Block Explorer API Keys (optional) ---
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
POLYGONSCAN_API_KEY=
ARBISCAN_API_KEY=
SNOWTRACE_API_KEY=

# --- Telegram Bot (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- API Authentication (recommended for production) ---
# Clients must send this key in the Authorization header.
# Generate a strong random key: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUDITOR_API_KEY=

# --- Flask Secret Key ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_random_secret

# --- Admin Panel Password ---
# Password for /admin login page
ADMIN_PASSWORD=admin123

# --- Auth DB Path (optional) ---
# AUTH_DB_PATH=/data/auth.db
