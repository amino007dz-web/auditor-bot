# =============================================================================
# Smart Contract Auditor — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your keys.
# NEVER commit the .env file to version control.
# =============================================================================

# --- LLM Provider ---
# Supported: ollama, openrouter, groq
API_PROVIDER=openrouter

# Ollama (local only)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen3-coder:480b
OLLAMA_TIMEOUT=300

# OpenRouter (recommended for production)
# Generate an API key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-your_key_here
# OPENROUTER_API_KEYS=key1,key2,key3,...

# --- Block Explorer API Keys (optional) ---
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
POLYGONSCAN_API_KEY=
ARBISCAN_API_KEY=
SNOWTRACE_API_KEY=

# --- Telegram Bot (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- API Authentication (recommended for production) ---
# Clients must send this key in the Authorization header.
# Generate a strong random key: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUDITOR_API_KEY=

# --- Flask Secret Key ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Leave empty to auto-generate on first run (persisted to .secret_key)
# IMPORTANT: On Render/production (/data exists), you MUST set this manually
SECRET_KEY=

# --- Admin Panel Password ---
# Password for /admin login page
# Leave empty to disable admin panel access
ADMIN_PASSWORD=

# --- Auth DB Path (optional) ---
# AUTH_DB_PATH=/data/auth.db

# --- GitHub OAuth (optional) ---
# Create an OAuth App at https://github.com/settings/developers
# Homepage URL: https://yourdomain.com
# Callback URL: https://yourdomain.com/login/github/callback
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=

# --- Monthly Free Credits ---
# Default: 5 audits per month for free users
# MONTHLY_FREE_CREDITS=5
